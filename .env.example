# ============================================================================
# 生产环境变量模板 · 复制为 .env 后填写真实值
#
# ⚠ 上云铁律（规划 §04）：本地 .env 的值按「已泄露」处理，绝不带上云——
#   本文件出现的所有 change-me / 密钥占位值都必须重生成后替换。
#   生成参考: openssl rand -base64 32（COOKIE_KEYS 逗号分隔两把）
# ============================================================================

# ---------- 镜像（ACR 个人版，免费；北京地域）----------
ACR_REGISTRY=registry.cn-beijing.aliyuncs.com/uixw
TAG=latest

# ---------- 对外地址 ----------
# 备案期（IP + 自签）——已按 ECS 实际公网 IP 填写:
SSO_ISSUER=https://47.94.14.235:8443/sso
SYNAPSE_PUBLIC_URL=https://47.94.14.235:8443/api/synapse
FRONTEND_URL=https://47.94.14.235:8443
CORS_ORIGIN=https://47.94.14.235:8443

# ---------- 数据库（两个独立账号分库）----------
SSO_DB_PASSWORD=change-me
SYNAPSE_DB_PASSWORD=change-me

# ---------- SSO 认证中心 ----------
# 生产管理员登录密码（admin@example.com，initdb/03 首启写入 users 表）
SSO_ADMIN_PASSWORD=change-me
SSO_COOKIE_KEYS=change-me-1,change-me-2
SSO_METRICS_TOKEN=change-me
# 邮件两段式: 163/QQ SMTP 授权码（过渡）→ 备案后阿里云邮件推送（仅改这几行）
# 163 示例: SMTP_HOST=smtp.163.com SMTP_PORT=465 SMTP_USER=xxx@163.com SMTP_PASS=<授权码>
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=change-me@163.com
SMTP_PASS=change-me
SMTP_FROM=change-me@163.com

# ---------- synapse 后端 ----------
# SSO 接入（BFF 模式，auth-center oauth_clients 注册 client_id=synapse 时生成）
SYNAPSE_SSO_CLIENT_SECRET=change-me
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me
# 内部回调 token（scanner-worker → /internal/scan-callback 的 x-internal-token）
INTERNAL_CALLBACK_TOKEN=change-me
# LLM 云端 API（OpenAI 兼容端点: DashScope / DeepSeek 等，按量计费）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_API_KEY=change-me
LLM_KEY_ENCRYPTION_KEY=change-me-32-char-key

# ---------- Supabase Storage（skill-market 文件存储，过渡期直连）----------
# ⚠ 上云前置开发任务: scanner 直调 Supabase API 需改写为直连共享 PG，
#   迁移完成后本组与 compose 中对应变量一并删除（规划 P2.5 / §05）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=change-me

# ---------- skill 扫描（LLM 云端 API）----------
SKILL_SCANNER_LLM_API_KEY=change-me
SKILL_SCANNER_LLM_MODEL=qwen-plus
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
